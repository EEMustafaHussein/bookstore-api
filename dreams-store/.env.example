# انسخ هذا الملف باسم .env ثم عدّل القيم.
# Copy this file to .env and change the values.

# مفتاح سري طويل وعشوائي (32 حرفاً على الأقل). لتوليد واحد:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-key-0123456789

# حساب المالك يُنشأ تلقائياً عند أول تشغيل (أو استخدم python create_owner.py)
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=ChangeMe2026
OWNER_NAME=اسمك

# عنوان الموقع (يُستخدم في روابط الرجوع من صفحة الدفع)
BASE_URL=http://127.0.0.1:8000

# اجعلها true عندما يعمل الموقع على https
COOKIE_SECURE=false

# قاعدة البيانات: SQLite افتراضياً. لـ PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dreams

# ---- الدفع بالبطاقة (ماستر كارد / فيزا) عبر Stripe ----
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd
# كم دينار يساوي دولاراً واحداً:
# STRIPE_EXCHANGE_RATE=1310

# دفع تجريبي لتجربة المتجر على جهازك فقط — لا تفعّله أبداً على الموقع الحقيقي
PAYMENT_DEMO_MODE=true
